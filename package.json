{
  "name": "routevela",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "context": "node tools/context.mjs",
    "check": "node tools/check.mjs",
    "test": "npm run build && node tools/test.mjs",
    "evidence": "node tools/evidence.mjs record",
    "verify:evidence": "node tools/evidence.mjs verify",
    "verify:prep": "npm run doctor && npm run check && npm test",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "lint": "eslint src --max-warnings=0",
    "audit": "npm audit --audit-level=high",
    "check:architecture": "node tools/architecture.mjs",
    "verify": "npm run doctor && npm run check && npm run typecheck && npm run lint && npm test && npm run audit",
    "demo": "npm run build && node tools/demo.mjs",
    "verify:local-evidence": "node tools/evidence.mjs verify-local P02"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "ws": "8.22.0"
  }
}
